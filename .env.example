# ===========================================
# VERITABANI (ayrı alanlar — Vercel için önerilen)
# ===========================================
MYSQL_HOST="mt-luca.guzelhosting.com"
MYSQL_PORT="3306"
MYSQL_USER="tokatsan_veritabani"
MYSQL_PASSWORD="SIFRE"
MYSQL_DATABASE="tokatsan_veritabani"

# İsteğe bağlı: tek satır (yukarıdakilerin yerine geçebilir)
# DATABASE_URL="mysql://USER:SIFRE@HOST:3306/DB"

# ===========================================
# AUTH (NextAuth)
# ===========================================
AUTH_SECRET="openssl-rand-base64-32-ile-uret"
NEXTAUTH_URL="https://tokatsanayisitesi.com"
# AUTH_URL — NextAuth v5 için isteğe bağlı (NEXTAUTH_URL ile aynı)
# AUTH_URL="https://tokatsanayisitesi.com"

# Gizli yönetim paneli yolu (/admin kapalıdır)
NEXT_PUBLIC_ADMIN_BASE_PATH="/yp-tokat-7x9k"

# ===========================================
# CLOUDINARY (Vercel görsel yükleme — ZORUNLU production)
# Dashboard: https://console.cloudinary.com → Settings → API Keys
# ===========================================
CLOUDINARY_CLOUD_NAME="ornek_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ===========================================
# RESEND (iletişim formu e-posta)
# ===========================================
RESEND_API_KEY="re_xxx"
CONTACT_NOTIFY_EMAIL="info@tokatsanayisitesi.com"
CONTACT_NOTIFY_FROM="Tokat Sanayi <info@tokatsanayisitesi.com>"

# ===========================================
# SEED (sadece lokal / bir kerelik — Vercel runtime için gerekmez)
# ===========================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="guclu-sifre"
PRESIDENT_USERNAME="baskan"
PRESIDENT_PASSWORD="guclu-sifre"

# ===========================================
# TURNSTILE (isteğe bağlı spam koruması)
# ===========================================
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."
