# Yerel geliştirme (SQLite — Docker/PostgreSQL gerekmez)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — docker compose up -d sonrası:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tokat_sanayi?schema=public"

# NextAuth
AUTH_SECRET="gelistirme-icin-rastgele-uzun-bir-secret-olusturun"
NEXTAUTH_URL="http://localhost:3000"

# Seed script için admin hesabı (opsiyonel)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Başkan paneli (opsiyonel)
PRESIDENT_USERNAME="baskan"
PRESIDENT_PASSWORD="baskan123"

